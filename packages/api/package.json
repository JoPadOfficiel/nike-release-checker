{
	"name": "@nike-release-checker/api",
	"version": "0.1.0",
	"description": "Fastify B2B REST API gateway",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"test": "node --import tsx --test 'src/**/*.test.ts'",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/swagger": "^9.0.0",
		"@fastify/swagger-ui": "^5.0.0",
		"fastify": "^5.0.0",
		"pino": "^9.0.0",
		"uuid": "^11.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/uuid": "^10.0.0",
		"tsx": "^4.0.0",
		"typescript": "^5.9.3"
	}
}
